{
  "name": "redrose-browser",
  "version": "1.0.0",
  "description": "RedRose Browser — a minimal, secure, Chromium-based desktop browser built with Electron.",
  "author": "Michael Alexander",
  "license": "GPL-3.0",
  "private": true,
  "main": "src/main/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "check-electron": "node scripts/check-electron-updates.js",
    "update-blocklist": "node scripts/update-blocklist.js",
    "update-adblock-lists": "node scripts/update-adblock-lists.js"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.redrose-browser.app",
    "productName": "RedRose Browser",
    "publish": null,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "!**/*.md"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "identity": null
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.18.2",
    "electron-chrome-extensions": "^4.9.0",
    "yauzl": "^3.4.0"
  }
}
